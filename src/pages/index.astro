---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { band, closing, hero, how, occasions, practical, signatures, statement, team } from '../content/site';
import { getAsset } from '../lib/images';
import { withBase } from '../lib/url';

const heroImg = getAsset(hero.image);
const bandImg = getAsset(band.image);
---

<Base overHero>
  {/* ───────────────────────────── פתיחה ───────────────────────────── */}
  <section class="hero" aria-labelledby="hero-t">
    <div class="hero__media">
      <Image
        src={heroImg}
        alt={hero.imageAlt}
        widths={[760, 1280, 1920]}
        sizes="(max-aspect-ratio: 3/4) 134vh, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
      <span class="hero__scrim" aria-hidden="true"></span>
    </div>

    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-t" class="hero__title">{hero.title}</h1>
      <p class="hero__sub">{hero.subtitle}</p>
      <div class="hero__cta">
        <a class="btn btn--gold" href={withBase(hero.primaryCta.href)}><span>{hero.primaryCta.label}</span></a>
        <a class="btn btn--light" href={withBase(hero.secondaryCta.href)}><span>{hero.secondaryCta.label}</span></a>
      </div>
    </div>

    <span class="hero__scroll" aria-hidden="true"></span>
  </section>

  {/* ──────────────────────────── הצהרה ───────────────────────────── */}
  <section class="section section--tight stmt">
    <div class="container--narrow reveal">
      <p class="stmt__text">{statement.text}</p>
    </div>
  </section>

  {/* ───────────────────────── שפת העיצוב ─────────────────────────── */}
  <section class="section section--champagne" aria-labelledby="sig-t">
    <div class="container">
      <header class="reveal sig__head">
        <p class="eyebrow">{signatures.eyebrow}</p>
        <h2 id="sig-t">{signatures.title}</h2>
      </header>

      <div class="sig">
        {signatures.items.map((it, i) => (
          <a class="sig__card reveal" style={`--reveal-delay:${i * 130}ms`} href={withBase(it.href)}>
            <span class="sig__media">
              <Image
                src={getAsset(it.image)}
                alt={it.alt}
                widths={[420, 640, 900]}
                sizes="(min-width: 900px) 31vw, 88vw"
                loading="lazy"
                quality={80}
              />
            </span>
            <span class="sig__body">
              <span class="sig__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{it.title}</h3>
              <span class="sig__text">{it.text}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ───────────────────────── תמונת רוחב ─────────────────────────── */}
  <section class="bleed reveal" aria-label="מיצב בתאורת ערב">
    <Image
      class="bleed__img"
      src={bandImg}
      alt={band.alt}
      widths={[900, 1440, 2000]}
      sizes="100vw"
      loading="lazy"
      quality={78}
    />
    <div class="bleed__inner reveal">
      <p class="bleed__quote">{band.quote}</p>
    </div>
  </section>

  {/* ──────────────────────────── אירועים ─────────────────────────── */}
  <section class="section" aria-labelledby="occ-t">
    <div class="container occ">
      <header class="reveal">
        <p class="eyebrow">{occasions.eyebrow}</p>
        <h2 id="occ-t">{occasions.title}</h2>
        <p class="occ__note">{occasions.note}</p>
      </header>
      <ul class="occ__list">
        {occasions.items.map((it, i) => (
          <li class="occ__item reveal" style={`--reveal-delay:${i * 60}ms`}>
            <span class="occ__dot" aria-hidden="true"></span>{it}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ───────────────────────── איך זה עובד ────────────────────────── */}
  <section class="section section--dark" aria-labelledby="how-t">
    <div class="container">
      <header class="reveal how__head">
        <p class="eyebrow">{how.eyebrow}</p>
        <h2 id="how-t">{how.title}</h2>
      </header>
      <ol class="how">
        {how.steps.map((s, i) => (
          <li class="how__step reveal" style={`--reveal-delay:${i * 130}ms`}>
            <span class="how__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ───────────────────────────── הפרטים ─────────────────────────── */}
  <section class="section section--tight" aria-labelledby="prc-t">
    <div class="container">
      <h2 id="prc-t" class="visually-hidden">הפרטים</h2>
      <p class="eyebrow reveal">{practical.eyebrow}</p>
      <ul class="prc">
        {practical.items.map((it, i) => (
          <li class="prc__item reveal" style={`--reveal-delay:${i * 110}ms`}>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ────────────────────────────── סיום ──────────────────────────── */}
  <section class="section section--champagne closing" aria-labelledby="cl-t">
    <div class="container--narrow reveal closing__inner">
      <p class="eyebrow eyebrow--center">{team.eyebrow}</p>
      <p class="closing__team">{team.text}</p>
      <h2 id="cl-t">{closing.title}</h2>
      <p class="lede">{closing.text}</p>
      <a class="btn btn--solid" href={withBase(closing.cta.href)}><span>{closing.cta.label}</span></a>
    </div>
  </section>
</Base>

<style>
  /* ───────────────────────────── פתיחה ───────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: clamp(6rem, 18vh, 12rem) clamp(4rem, 12vh, 8rem);
    margin-top: -5.25rem;
    background: var(--espresso);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 26% 45%;
    animation: slow-zoom 22s var(--ease) forwards;
  }

  @keyframes slow-zoom { from { transform: scale(1.08); } to { transform: scale(1); } }

  /* התמונות בהירות מאוד — בלי הצללה כבדה הטקסט הלבן פשוט נעלם */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      /* הכהייה ממוקדת בצד הטקסט (ימין ב-RTL) כדי שהפרח יישאר מואר */
      linear-gradient(to left,
        rgba(18, 13, 11, 0.9) 0%,
        rgba(18, 13, 11, 0.74) 28%,
        rgba(18, 13, 11, 0.3) 58%,
        transparent 80%),
      linear-gradient(to top,
        rgba(18, 13, 11, 0.72) 0%,
        rgba(18, 13, 11, 0.3) 32%,
        transparent 58%,
        rgba(18, 13, 11, 0.45) 100%);
  }

  .hero__inner { position: relative; color: var(--on-dark); }
  .hero__eyebrow { color: var(--gold-bright); }
  .hero__eyebrow::after { background: rgba(207, 174, 115, 0.5); }

  .hero__title {
    font-size: var(--s-5);
    line-height: 1.02;
    max-width: 16ch;
    text-shadow: 0 2px 40px rgba(18, 13, 11, 0.5);
  }

  .hero__sub {
    margin-top: 1.4rem;
    font-size: var(--s-1);
    font-weight: 300;
    color: rgba(245, 239, 230, 0.92);
    max-width: 36ch;
    text-shadow: 0 1px 24px rgba(18, 13, 11, 0.6);
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.75rem; }

  .hero__scroll {
    display: none;
    position: absolute;
    inset-inline-start: 50%;
    bottom: 1.75rem;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, transparent, rgba(245, 239, 230, 0.6));
  }

  @media (min-height: 760px) {
    .hero__scroll { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) { animation: none; }
  }

  /* ──────────────────────────── הצהרה ───────────────────────────── */
  .stmt { text-align: center; }

  .stmt__text {
    font-family: 'Bellefair', Georgia, serif;
    font-size: clamp(1.4rem, 1.05rem + 1.5vw, 2.3rem);
    line-height: 1.5;
    color: var(--ink);
  }

  /* ───────────────────────── שפת העיצוב ─────────────────────────── */
  .sig__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  .sig { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 780px) { .sig { grid-template-columns: repeat(3, 1fr); } }

  .sig__card { display: grid; gap: 1.5rem; text-decoration: none; align-content: start; }

  .sig__media { display: block; overflow: hidden; background: var(--sand); aspect-ratio: 3 / 4; }

  .sig__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .sig__card:hover .sig__media :global(img),
  .sig__card:focus-visible .sig__media :global(img) { transform: scale(1.06); }

  .sig__body { display: grid; gap: 0.6rem; }
  .sig__n { font-size: var(--s--1); letter-spacing: 0.26em; color: var(--gold-ink); }
  .sig__text { color: var(--ink-soft); font-weight: 300; }

  .sig__card h3 { position: relative; display: inline-block; }
  .sig__card h3::after {
    content: '';
    position: absolute; inset-inline: 0; bottom: -0.25rem;
    height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: right;
    transition: transform 0.5s var(--ease);
  }
  .sig__card:hover h3::after, .sig__card:focus-visible h3::after { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .sig__card:hover .sig__media :global(img) { transform: none; }
  }

  /* ───────────────────────── תמונת רוחב ─────────────────────────── */
  .bleed__quote {
    font-family: 'Bellefair', Georgia, serif;
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.8rem);
    line-height: 1.35;
  }

  /* ──────────────────────────── אירועים ─────────────────────────── */
  .occ { display: grid; gap: clamp(2rem, 5vw, 4.5rem); }
  @media (min-width: 900px) { .occ { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); } }

  .occ__note { margin-top: 1.1rem; color: var(--ink-muted); font-size: var(--s--1); letter-spacing: 0.06em; }

  .occ__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  @media (min-width: 560px) { .occ__list { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; } }

  .occ__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: 'Bellefair', Georgia, serif;
    font-size: var(--s-1);
  }

  .occ__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); flex: none; }

  /* ───────────────────────── איך זה עובד ────────────────────────── */
  .how__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .how { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2rem, 4vw, 3.5rem); counter-reset: step; }
  @media (min-width: 780px) { .how { grid-template-columns: repeat(3, 1fr); } }

  .how__step { display: grid; gap: 0.8rem; align-content: start; padding-top: 1.75rem; border-top: 1px solid var(--line-on-dark); }
  .how__n { font-family: 'Bellefair', Georgia, serif; font-size: var(--s-2); color: var(--gold-bright); line-height: 1; }
  .how__step p { color: var(--on-dark-soft); font-weight: 300; }

  /* ───────────────────────────── הפרטים ─────────────────────────── */
  .prc { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: clamp(1.75rem, 3.5vw, 3rem); }
  @media (min-width: 780px) { .prc { grid-template-columns: repeat(3, 1fr); } }

  .prc__item { display: grid; gap: 0.65rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .prc__item h3 { font-size: var(--s-1); }
  .prc__item p { color: var(--ink-soft); font-weight: 300; }

  /* ────────────────────────────── סיום ──────────────────────────── */
  .closing { text-align: center; }
  .closing__inner { display: grid; justify-items: center; gap: 1.4rem; }
  .closing__team { font-family: 'Bellefair', Georgia, serif; font-size: var(--s-1); color: var(--ink-soft); max-width: 44ch; margin-bottom: 0.8rem; }
  .closing .lede { margin-inline: auto; }
</style>
